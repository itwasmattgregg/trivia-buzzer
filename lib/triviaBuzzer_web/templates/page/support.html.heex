<section class="hero">
  <div class="hero-content">
    <h1 class="hero-title">Support Trivia Buzzer</h1>
    <p class="hero-subtitle">Help keep this project free and growing</p>
  </div>
</section>

<div class="container">
  <main id="main-content" role="main">
    <!-- Introduction Section -->
    <section class="glass-card mb-5" aria-labelledby="support-intro">
      <div class="text-center">
        <div class="feature-icon" style="font-size: 4rem; margin-bottom: var(--space-lg);">💚</div>
        <h2 id="support-intro" class="mb-4">Thank you for using Trivia Buzzer!</h2>
        <p style="font-size: 1.125rem; line-height: 1.8; max-width: 800px; margin: 0 auto;">
          Trivia Buzzer is a passion project built to make trivia nights more fun and accessible. 
          If you've enjoyed using the app and want to support its continued development, your contribution 
          would mean the world to me. Every bit helps keep the servers running, features improving, and 
          the app free for everyone to use.
        </p>
      </div>
    </section>

    <!-- What Your Support Helps With -->
    <section class="glass-card mb-5" aria-labelledby="what-support-helps">
      <h2 id="what-support-helps" class="text-center mb-4">What Your Support Helps With</h2>
      <div class="features-grid">
        <article class="feature">
          <div class="feature-icon">🚀</div>
          <h3>Server Costs</h3>
          <p>Keeping the app running smoothly and accessible 24/7</p>
        </article>
        <article class="feature">
          <div class="feature-icon">✨</div>
          <h3>New Features</h3>
          <p>Developing exciting new capabilities and improvements</p>
        </article>
        <article class="feature">
          <div class="feature-icon">🐛</div>
          <h3>Bug Fixes</h3>
          <p>Maintaining quality and fixing issues quickly</p>
        </article>
        <article class="feature">
          <div class="feature-icon">💡</div>
          <h3>Future Projects</h3>
          <p>Funding me to create other apps that help make people's lives easier</p>
        </article>
      </div>
    </section>

    <!-- Donation Section -->
    <section class="glass-card mb-5" aria-labelledby="donation-section">
      <div class="text-center mb-4">
        <h2 id="donation-section" class="mb-3">Make a Contribution</h2>
        <p style="font-size: 1rem; color: var(--text-secondary); max-width: 600px; margin: 0 auto;">
          Your support, no matter the size, helps ensure Trivia Buzzer remains free and continues to improve. 
          Thank you for being part of this community!
        </p>
      </div>
      
      <div style="max-width: 800px; margin: 0 auto; background: var(--glass-bg); padding: var(--space-md); border-radius: var(--radius-lg); border: 1px solid var(--glass-border);">
        <iframe 
          id='kofiframe' 
          src='https://ko-fi.com/itwasmattgregg/?hidefeed=true&widget=true&embed=true&preview=true' 
          style='border:none;width:100%;padding:4px;background:#f9f9f9;border-radius:var(--radius-md);' 
          height='712' 
          title='itwasmattgregg'
          loading="lazy">
        </iframe>
      </div>
    </section>

    <!-- Alternative Ways to Support -->
    <section class="glass-card" aria-labelledby="other-ways">
      <h2 id="other-ways" class="text-center mb-4">Other Ways to Support</h2>
      <div class="features-grid">
        <article class="feature">
          <div class="feature-icon">⭐</div>
          <h3>Share the App</h3>
          <p>Tell friends, family, and colleagues about Trivia Buzzer</p>
        </article>
        <article class="feature">
          <div class="feature-icon">💬</div>
          <h3>Give Feedback</h3>
          <p>Share your ideas and suggestions for improvements</p>
        </article>
        <article class="feature">
          <div class="feature-icon">🐛</div>
          <h3>Report Issues</h3>
          <p>Help improve the app by reporting bugs you encounter</p>
        </article>
      </div>
    </section>

    <!-- Contact Section -->
    <section class="glass-card mt-5" aria-labelledby="contact-section">
      <div class="text-center">
        <h2 id="contact-section" class="mb-4">Have Questions or Issues?</h2>
        <p style="font-size: 1rem; color: var(--text-secondary); max-width: 600px; margin: 0 auto var(--space-lg);">
          If you'd like to contact me about issues, bugs, or have questions, please log an issue on GitHub or reach out via email.
        </p>
        <div style="display: flex; gap: var(--space-lg); justify-content: center; flex-wrap: wrap; align-items: center;">
          <a href="https://github.com/itwasmattgregg/trivia-buzzer" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            📝 Log an Issue on GitHub
          </a>
          <a href="mailto:matt@codegregg.com" class="btn btn-secondary">
            ✉️ Email: matt@codegregg.com
          </a>
        </div>
      </div>
    </section>

    <!-- Back to Home Link -->
    <div class="text-center mt-5 mb-5">
      <a href="/" class="btn btn-secondary btn-large">
        ← Back to Home
      </a>
    </div>
  </main>
</div>
