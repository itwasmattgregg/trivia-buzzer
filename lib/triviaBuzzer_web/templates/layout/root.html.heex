<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8"/>
    <meta http-equiv="X-UA-Compatible" content="IE=edge"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <meta name="csrf-token" content={csrf_token_value()}>
    <%= live_title_tag assigns[:page_title] || "Trivia Buzzer" %>
    <link phx-track-static rel="stylesheet" href={Routes.static_path(@conn, "/assets/app.css")}/>
    <script defer phx-track-static type="text/javascript" src={Routes.static_path(@conn, "/assets/app.js")}></script>
  </head>
  <body>
    <%= @inner_content %>
    <footer class="app-footer">
      <p>Made with <a href="https://www.phoenixframework.org/" target="_blank" rel="noopener">Phoenix</a> and love by <a href="https://codegregg.com" target="_blank" rel="noopener">Matt Gregg</a></p>
    </footer>
  </body>
</html>
